---
interface Props { theme?: 'dark' | 'light' }
const { theme = 'dark' } = Astro.props;
---

<div class="pond" aria-hidden="true">
  <canvas id="koi-pond" data-theme={theme}></canvas>
</div>
<div class:list={['pond-toolbar', { 'pond-toolbar-light': theme === 'light' }]}>
  <div class="pond-caption" aria-hidden="true">four koi / a quiet current<span>click anywhere to ripple</span></div>
  <button class="pond-toggle" id="pond-toggle" type="button" aria-pressed="false" hidden>pause pond</button>
</div>

<script>
  import { createPond } from '../scripts/koi-pond';
  const canvas = document.querySelector<HTMLCanvasElement>('#koi-pond');
  const toggle = document.querySelector<HTMLButtonElement>('#pond-toggle');
  if (canvas && toggle) createPond(canvas, toggle);
</script>

<style>
  .pond { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  canvas { display: block; width: 100%; height: 100%; }
  .pond-toolbar {
    position: fixed; inset: auto 0 0; z-index: 3; display: flex;
    justify-content: space-between; align-items: end; gap: 1rem;
    padding: 3rem 2rem 1.5rem; pointer-events: none;
    background: linear-gradient(transparent, #071318ed);
  }
  .pond-caption, .pond-toggle {
    font: 10px/1.8 ui-monospace, Menlo, Consolas, monospace;
    letter-spacing: .08em; color: #91aea6;
  }
  .pond-caption { pointer-events: none; }
  .pond-caption span { display: block; color: #718c86; }
  .pond-toggle {
    background: #0c2026e6; border: 1px solid #426060; pointer-events: auto;
    padding: .4rem .85rem; cursor: pointer; border-radius: 3px;
  }
  .pond-toggle:hover { color: #ead9b8; border-color: #8c947f; }
  .pond-toolbar-light { background: linear-gradient(transparent, #f3f3eae8); }
  .pond-toolbar-light .pond-caption { color: #697b67; }
  .pond-toolbar-light .pond-caption span { color: #7d8875; }
  .pond-toolbar-light .pond-toggle { background: #f8f8efe8; color: #52624f; border-color: #adb8a4; }
  .pond-toolbar-light .pond-toggle:hover { color: #263e2e; border-color: #52624f; }
  @media (max-width: 600px) {
    .pond-toolbar { padding: 2.5rem 1rem .85rem; }
    .pond-caption { font-size: 9px; }
    .pond-toggle { min-height: 44px; }
  }
  @media print { .pond, .pond-toolbar { display: none; } }
</style>
