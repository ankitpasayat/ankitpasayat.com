---
// Shared chrome for plain mode: zero JS, zero shared CSS with the terminal,
// prints cleanly. Deliberately its own quiet world — paper, serif, hairlines.
interface Props {
  title?: string;
  description?: string;
  terminal?: string; // this page's terminal-mode counterpart
}
const {
  title = 'Ankit Pasayat',
  description = 'Ankit Pasayat, senior engineer, Bengaluru. Open to work.',
  terminal = '/',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = Astro.url.pathname.replace(/\/+$/, '');
const nav = [
  ['/plain', 'Home'],
  ['/plain/blog', 'Blog'],
  ['/plain/now', 'Now'],
  ['/plain/uses', 'Uses'],
].filter(([href]) => href !== here);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      * { margin: 0; box-sizing: border-box; }
      body {
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: #fbfaf7;
        color: #211e18;
        font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, 'Times New Roman', serif;
        font-size: 1.06rem;
        line-height: 1.75;
        padding: clamp(1.5rem, 5vw, 3rem) 1.25rem;
        text-align: center;
      }
      main { max-width: 34rem; width: 100%; min-width: 0; }
      h1 {
        font-size: clamp(1.8rem, 5vw, 2.2rem);
        font-weight: 400;
        letter-spacing: 0.01em;
        color: #7d5a1c;
      }
      hr {
        border: 0;
        border-top: 1px solid #ddd7c9;
        width: 3.5rem;
        margin: 1.7rem auto;
      }
      p + p { margin-top: 0.55rem; }
      ul { list-style: none; display: grid; gap: 0.55rem; padding: 0; }
      a {
        color: #7d5a1c;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }
      a:focus-visible { outline: 2px solid #211e18; outline-offset: 2px; }
      .dim { color: #6b6455; }
      footer { margin-top: 1.7rem; font-size: 0.92rem; color: #6b6455; }
      footer nav {
        display: flex;
        justify-content: center;
        column-gap: 1.4rem;
        row-gap: 0.35rem;
        flex-wrap: wrap;
      }
      @media print { footer { display: none; } }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <hr />
      <footer>
        <nav>
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href={terminal}>Terminal version</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
