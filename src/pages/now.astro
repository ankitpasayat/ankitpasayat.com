---
import Base from '../layouts/Base.astro';
---

<Base title="now" description="what ankit pasayat is doing now">
  <main>
    <header class="sysline">
      <span>ssh home@ankitpasayat.com</span>
      <a href="/">[ home ]</a>
    </header>

    <div class="line">
      <span class="prompt-user">$</span> cat now.txt
    </div>
    <div class="grid">
      <span class="cmt">building</span>
      <span><a href="https://github.com/ankitpasayat/connectivity-credits-demo">connectivity credits</a>, an independent backend prototype using synthetic school-connectivity data</span>
      <span class="cmt">shipping</span>
      <span>this site: a working terminal, a plain version, and a character-drawn koi pond</span>
      <span class="cmt">workflow</span>
      <span>ai-assisted development · claude code and codex · i plan, build and review</span>
      <span class="cmt">built</span>
      <span><a href="https://hireaclanker.com">hire a clanker</a>, the initial gmat-prep product and question content · <a href="https://thepile.gg">thepile.gg</a>, game tracker</span>
      <span class="cmt">status</span>
      <span><span class="status-dot">●</span> open to work · <a href="mailto:ankitpasayat@gmail.com">say hi</a></span>
    </div>
    <p class="cmt" style="margin-top:1.4rem">last updated: oct 2026</p>

    <footer><a href="/">← home</a> · <a href="/plain/now">plain</a></footer>
  </main>
</Base>
