<style>
  .role { color: #6b6455; }
  .role em { font-style: italic; color: #7d5a1c; }
  .links {
    display: flex;
    justify-content: center;
    column-gap: 1.4rem;
    row-gap: 0.35rem;
    flex-wrap: wrap;
  }
  li :global(.dim a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: currentColor;
  }
</style>
