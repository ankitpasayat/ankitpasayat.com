---
import Base from '../layouts/Base.astro';
---

<Base title="uses" description="tools ankit pasayat uses">
  <main>
    <header class="sysline">
      <span>ssh home@ankitpasayat.com</span>
      <a href="/">[ home ]</a>
    </header>

    <div class="line">
      <span class="prompt-user">$</span> cat uses.txt
    </div>
    <div class="grid">
      <span class="cmt">os</span><span>macos</span>
      <span class="cmt">shell</span><span>zsh</span>
      <span class="cmt">tools</span><span>vs code · claude code · codex</span>
      <span class="cmt">stack</span><span>typescript · react · node.js / express · python · postgresql</span>
      <span class="cmt">ai</span><span>ai-assisted development · i plan, build and review</span>
    </div>

    <footer><a href="/">← home</a> · <a href="/plain/uses">plain</a></footer>
  </main>
</Base>
